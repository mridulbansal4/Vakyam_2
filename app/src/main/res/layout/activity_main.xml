<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas"
    android:orientation="vertical"
    tools:context="com.demo.opencv.MainActivity">

    <!-- One row of folder tabs: widths are shared by label length and the text shrinks to fit, so no label wraps.
         Every tab after the first starts -32dp in so neighbouring tabs overlap. -->
    <LinearLayout
        android:id="@+id/topTabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vk_chrome"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/devModeButton"
            style="@style/TopTab"
            android:layout_weight="1.2"
            android:text="@string/Settings_Title" />

        <TextView
            android:id="@+id/quickChatButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="0.9"
            android:text="@string/QuickChat_TopBarTitle" />

        <TextView
            android:id="@+id/textModeButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="1.4"
            android:text="@string/TextEntry_TopBarTitle" />

        <TextView
            android:id="@+id/calibrateButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="1.6"
            android:text="@string/Calibration_TopBarTitle" />

        <TextView
            android:id="@+id/clinicianModeButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="0.8"
            android:text="@string/Clinician_TopBarTitle" />

        <TextView
            android:id="@+id/blinkKeyboardButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="1.1"
            android:contentDescription="Spell with Eyes"
            android:text="Spell"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/sosButton"
            style="@style/TopTab"
            android:layout_marginStart="-32dp"
            android:layout_weight="0.8"
            android:contentDescription="@string/Emergency_Title"
            android:text="@string/Emergency_SosButton" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/typingTestBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vk_accent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/typingTestText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/vk_on_chrome"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="TYPING TEST: i am thirsty" />

        <Button
            android:id="@+id/typingTestDone"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TypingTest_Done"
            android:textColor="@color/vk_on_chrome"
            android:textStyle="bold" />

        <Button
            android:id="@+id/typingTestClose"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TypingTest_Close"
            android:textColor="@color/vk_on_chrome"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/sensorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/vk_on_chrome"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/warmTintOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00FF9329"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <com.demo.opencv.sensors.RingLightView
            android:id="@+id/ringLightOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
