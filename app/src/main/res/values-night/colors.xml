<?xml version="1.0" encoding="utf-8"?>
<!--
    Dim-room palette, used when the phone is in dark mode. A bright page in a dark room is the main
    source of glare, so the ground drops to a warm charcoal (not black) and the ink to a warm off-white
    (not white), keeping contrast near 10:1 without halation.
-->
<resources>
    <color name="vk_canvas">#232A27</color>
    <color name="vk_surface">#2C3531</color>
    <color name="vk_surface_tint">#2F423B</color>
    <color name="vk_track">#3A433F</color>
