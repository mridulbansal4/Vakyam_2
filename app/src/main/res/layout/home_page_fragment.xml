<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".fragments.home_page_display">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/homeLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/vakyam_logo"
        app:shapeAppearanceOverlay="@style/HomeLogo" />

    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_space_l"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:text="@string/app_name"
        android:textColor="@color/vk_ink"
        android:textSize="48sp" />

</LinearLayout>
