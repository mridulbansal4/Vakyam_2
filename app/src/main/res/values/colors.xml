<?xml version="1.0" encoding="utf-8"?>
<!--
    Low-strain palette. The screen is read for hours by someone who cannot look away from it, so:
    - dark text on a light ground (small pupil, sharper focus), but warm paper instead of white to cut glare
    - ink is a deep green-grey, never pure black, to avoid halation at the edges of bold letters
    - hues sit in the green-yellow band the eye focuses with least effort; no saturated blue or violet
    - every screen has the same overall brightness so the pupil is not re-adapting on each page change
    - amber marks what is being selected, soft green what was selected, red is kept for emergencies only
    Dim-room counterparts live in values-night/colors.xml.
-->
<resources>
    <!-- Grounds -->
    <color name="vk_canvas">#F1EEE4</color>
    <color name="vk_surface">#FAF8F1</color>
    <color name="vk_surface_tint">#D5E4DB</color>
    <color name="vk_track">#DDD9CB</color>
    <color name="vk_scrim">#A626342F</color>

    <!-- Gaze tiles and keys -->
    <color name="vk_key">#DAE5D1</color>
    <color name="vk_key_alt">#E8DEC8</color>
    <color name="vk_key_selecting">#EDC565</color>
    <color name="vk_key_selected">#B9DAAE</color>
    <color name="vk_outline">#768675</color>

    <!-- Text -->
    <color name="vk_ink">#26342F</color>
    <color name="vk_ink_soft">#4C5D56</color>
    <color name="vk_ink_muted">#5C6E66</color>

    <!-- Navigation bar and buttons -->
    <color name="vk_chrome">#34463F</color>
    <color name="vk_accent">#48615A</color>
    <color name="vk_on_chrome">#F4F1E8</color>

    <!-- Direction badges on gaze tiles: quiet until the tile is being selected -->
    <color name="vk_badge">#EEF2EA</color>
    <color name="vk_badge_ink">#34463F</color>

    <!-- Top bar: the current screen is a light pill joined in colour to the page -->
    <color name="vk_tab_idle_text">#C9D3CC</color>

    <!-- Spell keyboard: light flat keys on a warm grey tray, darker function keys -->
    <color name="vk_tray">#DCD7C8</color>
    <color name="vk_key_flat">#FBF9F3</color>
    <color name="vk_key_function">#C9C3B1</color>
    <color name="vk_key_shadow">#40303A35</color>

    <!-- Status -->
    <color name="vk_warning">#D2694F</color>
    <color name="vk_emergency">#C62828</color>
    <color name="vk_on_emergency">#FFF8F5</color>
</resources>
