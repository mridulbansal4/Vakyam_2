<?xml version="1.0" encoding="utf-8"?>
<!-- 3 x 2 grid of equal tiles: 16dp from every screen edge, 12dp between tiles.
     Each tile's badge sits in the corner matching its gaze direction. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas"
    android:padding="@dimen/vk_screen_margin"
    tools:context=".fragments.quick_chat_display">

    <TextView
        android:id="@+id/QuickChatLeftUp"
        style="@style/Vk.Tile"
        android:layout_marginEnd="@dimen/vk_space_s"
        android:layout_marginBottom="@dimen/vk_half_gutter"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintBottom_toTopOf="@id/QuickChatLeft"
        app:layout_constraintEnd_toStartOf="@id/QuickChatUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Basic needs" />

    <TextView
        android:id="@+id/QuickChatUp"
        style="@style/Vk.Tile"
        android:layout_marginStart="@dimen/vk_space_xs"
        android:layout_marginEnd="@dimen/vk_space_xs"
        android:layout_marginBottom="@dimen/vk_half_gutter"
        android:background="@drawable/gaze_option_bg_2"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintBottom_toTopOf="@id/QuickChatClosed"
        app:layout_constraintEnd_toStartOf="@id/QuickChatRightUp"
        app:layout_constraintStart_toEndOf="@id/QuickChatLeftUp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Back to home page" />

    <TextView
        android:id="@+id/QuickChatRightUp"
        style="@style/Vk.Tile"
        android:layout_marginStart="@dimen/vk_space_s"
        android:layout_marginBottom="@dimen/vk_half_gutter"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintBottom_toTopOf="@id/QuickChatRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/QuickChatUp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Emotions" />

    <TextView
        android:id="@+id/QuickChatLeft"
        style="@style/Vk.Tile"
        android:layout_marginTop="@dimen/vk_half_gutter"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/QuickChatLeftUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/QuickChatLeftUp"
        tools:text="Surroundings" />

    <TextView
        android:id="@+id/QuickChatClosed"
        style="@style/Vk.Tile"
        android:layout_marginTop="@dimen/vk_half_gutter"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/QuickChatUp"
        app:layout_constraintStart_toStartOf="@id/QuickChatUp"
        app:layout_constraintTop_toBottomOf="@id/QuickChatUp"
        tools:text="Activities" />

    <TextView
        android:id="@+id/QuickChatRight"
        style="@style/Vk.Tile"
        android:layout_marginTop="@dimen/vk_half_gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingTop="@dimen/vk_tile_top_clearance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/QuickChatRightUp"
        app:layout_constraintTop_toBottomOf="@id/QuickChatRightUp"
        tools:text="Medical needs" />

    <ImageView
        android:id="@+id/TextEntryLeftUpImage"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_left_up"
        app:layout_constraintStart_toStartOf="@id/QuickChatLeftUp"
        app:layout_constraintTop_toTopOf="@id/QuickChatLeftUp" />

    <ImageView
        android:id="@+id/QuickChatUpImage"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_up"
        app:layout_constraintEnd_toEndOf="@id/QuickChatUp"
        app:layout_constraintStart_toStartOf="@id/QuickChatUp"
        app:layout_constraintTop_toTopOf="@id/QuickChatUp" />

    <ImageView
        android:id="@+id/QuickChatRightUpImage"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:layout_marginEnd="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_right_up"
        app:layout_constraintEnd_toEndOf="@id/QuickChatRightUp"
        app:layout_constraintTop_toTopOf="@id/QuickChatRightUp" />

    <ImageView
        android:id="@+id/QuickChatLeftImage"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_left"
        app:layout_constraintStart_toStartOf="@id/QuickChatLeft"
        app:layout_constraintTop_toTopOf="@id/QuickChatLeft" />

    <ImageView
        android:id="@+id/QuickChatClosedImage"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_closed"
        app:layout_constraintEnd_toEndOf="@id/QuickChatClosed"
        app:layout_constraintStart_toStartOf="@id/QuickChatClosed"
        app:layout_constraintTop_toTopOf="@id/QuickChatClosed" />

    <ImageView
        android:id="@+id/QuickChatRightImage"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:layout_marginEnd="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_right"
        app:layout_constraintEnd_toEndOf="@id/QuickChatRight"
        app:layout_constraintTop_toTopOf="@id/QuickChatRight" />
</androidx.constraintlayout.widget.ConstraintLayout>
