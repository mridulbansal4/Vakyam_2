<?xml version="1.0" encoding="utf-8"?>
<!-- Caregiver data: gaze log and typing tests side by side, vocabulary and the chart below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clinicianModeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/vk_screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/vk_half_gutter"
                android:layout_weight="1.2"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/vk_space_l">

                    <TextView
                        android:id="@+id/gazeLogTitle"
                        style="@style/Vk.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/Clinician_GazeInputLog" />

                    <TextView
                        android:id="@+id/gazeLogText"
                        style="@style/Vk.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vk_space_s"
                        android:lineSpacingExtra="4sp"
                        tools:text="Left, Up, Closed" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vk_half_gutter"
                android:layout_weight="1"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/vk_space_l">

                    <TextView
                        android:id="@+id/textView10"
                        style="@style/Vk.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/TypingTest_Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vk_space_s"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/typingTestStartButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/vk_space_s"
                            android:text="@string/TypingTest_Start" />

                        <Button
                            android:id="@+id/typingTestShareButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/TypingTest_Share"
                            android:textAllCaps="false"
                            android:textColor="@color/vk_accent"
                            android:textSize="@dimen/vk_text_label"
                            app:cornerRadius="@dimen/vk_radius_box"
                            app:strokeColor="@color/vk_outline"
                            xmlns:app="http://schemas.android.com/apk/res-auto" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vk_space_s">

                        <TextView
                            android:id="@+id/typingTestResults"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/vk_ink"
                            android:textSize="13sp"
                            tools:text="gaze-letter      3 tests  avg  2.1 WPM" />
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/vk_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vk.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Vocabulary_Title" />

                <Button
                    android:id="@+id/vocabularyForgetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Vocabulary_Forget" />
            </LinearLayout>

            <TextView
                android:id="@+id/vocabularySummary"
                style="@style/Vk.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_space_s"
                android:textSize="@dimen/vk_text_caption"
                tools:text="Words: Harshad ×5, water ×4" />
        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="@dimen/vk_gutter"
            android:background="@drawable/bg_card"
            android:padding="@dimen/vk_space_s" />

    </LinearLayout>
</ScrollView>
