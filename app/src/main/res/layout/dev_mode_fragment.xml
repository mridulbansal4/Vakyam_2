<?xml version="1.0" encoding="utf-8"?>
<!-- Caregiver settings: preferences on the left, live camera and detection on the right, sensor tests below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/devModeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas"
    tools:context=".fragments.dev_mode_display">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/vk_screen_margin">

        <TextView
            android:id="@+id/gazeDetectionStastics"
            style="@style/Vk.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_space_m"
            android:text="@string/Settings_Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Preferences -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vk_half_gutter"
                android:layout_weight="1.15"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/vk_space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView6"
                        style="@style/Vk.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/Settings_Language" />

                    <Spinner
                        android:id="@+id/languageSpinner"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="0.6"
                        android:background="@drawable/text_rounded_light_green"
                        android:entries="@array/language_options"
                        android:popupBackground="@drawable/bg_card" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView7"
                        style="@style/Vk.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/Settings_TextEntryMode" />

                    <Spinner
                        android:id="@+id/textEntrySpinner"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="0.6"
                        android:background="@drawable/text_rounded_light_green"
                        android:entries="@array/textEntry_options"
                        android:popupBackground="@drawable/bg_card" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sensitivityTitle"
                        style="@style/Vk.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/Settings_GazeSensitivity" />

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:max="255"
                        android:minHeight="30dp"
                        android:progress="15"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_thumb" />

                    <TextView
                        android:id="@+id/textView5"
                        style="@style/Vk.Text.Label"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        tools:text="15" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Vk.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/Settings_CaregiverPhone" />

                    <EditText
                        android:id="@+id/caregiverPhoneInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="0.6"
                        android:autofillHints="phone"
                        android:background="@drawable/text_rounded_light_green"
                        android:hint="@string/Settings_CaregiverPhoneHint"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:paddingStart="@dimen/vk_space_l"
                        android:paddingEnd="@dimen/vk_space_l"
                        android:textColor="@color/vk_ink"
                        android:textColorHint="@color/vk_ink_muted"
                        android:textSize="@dimen/vk_text_label" />

                    <Button
                        android:id="@+id/caregiverPhoneSave"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/vk_space_s"
                        android:minHeight="48dp"
                        android:text="@string/Settings_Save" />
                </LinearLayout>

                <TextView
                    style="@style/Vk.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vk_space_s"
                    android:text="@string/Settings_HelpSignalHint" />
            </LinearLayout>

            <!-- Camera and detection -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vk_half_gutter"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/vk_space_l">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/text_rounded_light_green"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    tools:srcCompat="@tools:sample/avatars" />

                <TextView
                    android:id="@+id/textView1"
                    style="@style/Vk.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vk_space_m"
                    tools:text="Gaze detected" />

                <TextView
                    android:id="@+id/textView2"
                    style="@style/Vk.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Overall gaze type: Straight" />

                <TextView
                    android:id="@+id/textView3"
                    style="@style/Vk.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Overall loss: 0.12" />

                <TextView
                    android:id="@+id/textView4"
                    style="@style/Vk.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gazeInputLog2"
                    style="@style/Vk.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vk_space_s"
                    android:maxLines="3"
                    android:ellipsize="start"
                    tools:text="Gaze input log: Left, Up, Closed" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sensor test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/vk_space_l">

            <TextView
                style="@style/Vk.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vk_space_s"
                android:text="@string/Sensor_TestTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/simDarkRoomButton"
                    style="@style/SensorTestButton"
                    android:text="@string/Sensor_TestDarkRoom" />

                <Button
                    android:id="@+id/simHotPhoneButton"
                    style="@style/SensorTestButton"
                    android:text="@string/Sensor_TestHotPhone" />

                <Button
                    android:id="@+id/simChargingHotButton"
                    style="@style/SensorTestButton"
                    android:text="@string/Sensor_TestChargingHot" />

                <Button
                    android:id="@+id/simWarmLightButton"
                    style="@style/SensorTestButton"
                    android:text="@string/Sensor_TestWarmLight" />

                <Button
                    android:id="@+id/simResetButton"
                    style="@style/SensorTestButton"
                    android:layout_marginEnd="0dp"
                    android:text="@string/Sensor_TestReset" />
            </LinearLayout>

            <TextView
                android:id="@+id/sensorHealthText"
                style="@style/Vk.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_space_m"
                android:fontFamily="monospace"
                android:text="@string/Sensor_HealthWaiting"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
