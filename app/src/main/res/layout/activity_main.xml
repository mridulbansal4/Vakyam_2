<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas"
    android:orientation="vertical"
    tools:context="com.demo.opencv.MainActivity">

    <!-- Patient modes first, then caregiver tools after a divider. -->
    <LinearLayout
        android:id="@+id/topTabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vk_top_bar"
        android:background="@color/vk_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vk_screen_margin"
        android:paddingEnd="@dimen/vk_screen_margin"
        android:visibility="visible">

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vk_space_l"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/vk_on_chrome"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/quickChatButton"
            style="@style/TopTab"
            android:text="@string/QuickChat_TopBarTitle" />

        <TextView
            android:id="@+id/textModeButton"
            style="@style/TopTab"
            android:text="@string/TextEntry_TopBarTitle" />

        <TextView
            android:id="@+id/blinkKeyboardButton"
            style="@style/TopTab"
            android:contentDescription="Spell with Eyes"
            android:text="Spell"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/vk_space_m"
            android:layout_marginEnd="@dimen/vk_space_m"
            android:background="@color/vk_tab_idle_text"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/calibrateButton"
            style="@style/TopTab"
            android:text="@string/Calibration_TopBarTitle" />

        <TextView
            android:id="@+id/clinicianModeButton"
            style="@style/TopTab"
            android:text="@string/Clinician_TopBarTitle" />

        <TextView
            android:id="@+id/devModeButton"
            style="@style/TopTab"
            android:text="@string/Settings_Title" />

        <!-- Phone heat and charging status: a chip, so the screen below never shifts. Tap for the full message.
             It takes whatever room the brand and tabs leave, so neither of those ever has to give way. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

        <TextView
            android:id="@+id/sensorBanner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_status_chip"
            android:clickable="true"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:textColor="@color/vk_on_chrome"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_thermometer"
            tools:text="Phone warm"
            tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/typingTestBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vk_accent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/typingTestText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/vk_on_chrome"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="TYPING TEST: i am thirsty" />

        <Button
            android:id="@+id/typingTestDone"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TypingTest_Done"
            android:textColor="@color/vk_on_chrome"
            android:textStyle="bold" />

        <Button
            android:id="@+id/typingTestClose"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TypingTest_Close"
            android:textColor="@color/vk_on_chrome"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/warmTintOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00FF9329"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <com.demo.opencv.sensors.RingLightView
            android:id="@+id/ringLightOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
