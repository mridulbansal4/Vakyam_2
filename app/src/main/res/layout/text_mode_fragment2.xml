<?xml version="1.0" encoding="utf-8"?>
<!-- Three columns on a 16dp margin / 12dp gutter grid.
     Sides: four corner tiles, each holding a main option (badge row) and a sub option (lower part).
     Centre: Switch and Finish, then typed letters, the suggested sentence and the context.
     The finish overlay (darkenLayer, finishBox, speak and back) sits above everything. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_canvas">

    <!-- Column skeleton -->
    <Space
        android:id="@+id/centerColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/vk_gutter"
        android:layout_marginTop="@dimen/vk_screen_margin"
        android:layout_marginEnd="@dimen/vk_gutter"
        android:layout_marginBottom="@dimen/vk_screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightUpGazeText2"
        app:layout_constraintHorizontal_weight="1.45"
        app:layout_constraintStart_toEndOf="@id/leftUpGazeText2"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left column -->
    <TextView
        android:id="@+id/leftUpGazeText2"
        style="@style/Vk.KeyTile"
        android:layout_marginStart="@dimen/vk_screen_margin"
        android:layout_marginTop="@dimen/vk_screen_margin"
        android:layout_marginBottom="@dimen/vk_half_gutter"
        app:layout_constraintBottom_toTopOf="@id/leftGazeText2"
        app:layout_constraintEnd_toStartOf="@id/centerColumn"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="ABCDEF" />

    <TextView
        android:id="@+id/leftGazeText2"
        style="@style/Vk.KeyTile"
        android:layout_marginTop="@dimen/vk_half_gutter"
        android:layout_marginBottom="@dimen/vk_screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/leftUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/leftUpGazeText2"
        app:layout_constraintTop_toBottomOf="@id/leftUpGazeText2"
        tools:text="NOPQRST" />

    <!-- Right column -->
    <TextView
        android:id="@+id/rightUpGazeText2"
        style="@style/Vk.KeyTile"
        android:layout_marginTop="@dimen/vk_screen_margin"
        android:layout_marginEnd="@dimen/vk_screen_margin"
        android:layout_marginBottom="@dimen/vk_half_gutter"
        app:layout_constraintBottom_toTopOf="@id/rightGazeText2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/centerColumn"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="GHIJKLM" />

    <TextView
        android:id="@+id/rightGazeText2"
        style="@style/Vk.KeyTile"
        android:layout_marginTop="@dimen/vk_half_gutter"
        android:layout_marginBottom="@dimen/vk_screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/rightUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/rightUpGazeText2"
        app:layout_constraintTop_toBottomOf="@id/rightUpGazeText2"
        tools:text="UVWXYZ" />

    <!-- Dividers between main and sub option -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/vk_space_l"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="@dimen/vk_space_l"
        android:alpha="0.35"
        android:background="@color/vk_outline"
        app:layout_constraintEnd_toEndOf="@id/leftUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/leftUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftUpGazeText2" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/vk_space_l"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="@dimen/vk_space_l"
        android:alpha="0.35"
        android:background="@color/vk_outline"
        app:layout_constraintEnd_toEndOf="@id/leftGazeText2"
        app:layout_constraintStart_toStartOf="@id/leftGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftGazeText2" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/vk_space_l"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="@dimen/vk_space_l"
        android:alpha="0.35"
        android:background="@color/vk_outline"
        app:layout_constraintEnd_toEndOf="@id/rightUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/rightUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightUpGazeText2" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/vk_space_l"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="@dimen/vk_space_l"
        android:alpha="0.35"
        android:background="@color/vk_outline"
        app:layout_constraintEnd_toEndOf="@id/rightGazeText2"
        app:layout_constraintStart_toStartOf="@id/rightGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightGazeText2" />

    <!-- Sub options: the lower part of each corner tile -->
    <TextView
        android:id="@+id/leftUpGazeSubText"
        style="@style/Vk.KeySub"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toBottomOf="@id/leftUpGazeText2"
        app:layout_constraintEnd_toEndOf="@id/leftUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/leftUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftUpGazeText2"
        tools:text="hello" />

    <TextView
        android:id="@+id/leftGazeSubText"
        style="@style/Vk.KeySub"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toBottomOf="@id/leftGazeText2"
        app:layout_constraintEnd_toEndOf="@id/leftGazeText2"
        app:layout_constraintStart_toStartOf="@id/leftGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftGazeText2"
        tools:text="water" />

    <TextView
        android:id="@+id/rightUpGazeSubText"
        style="@style/Vk.KeySub"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toBottomOf="@id/rightUpGazeText2"
        app:layout_constraintEnd_toEndOf="@id/rightUpGazeText2"
        app:layout_constraintStart_toStartOf="@id/rightUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightUpGazeText2"
        tools:text="good" />

    <TextView
        android:id="@+id/rightGazeSubText"
        style="@style/Vk.KeySub"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toBottomOf="@id/rightGazeText2"
        app:layout_constraintEnd_toEndOf="@id/rightGazeText2"
        app:layout_constraintStart_toStartOf="@id/rightGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightGazeText2"
        tools:text="thanks" />

    <!-- Corner badges -->
    <ImageView
        android:id="@+id/TextEntryLeftUpImage"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_left_up"
        app:layout_constraintStart_toStartOf="@id/leftUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftUpGazeText2" />

    <ImageView
        android:id="@+id/imageView13"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_left"
        app:layout_constraintStart_toStartOf="@id/leftGazeText2"
        app:layout_constraintTop_toTopOf="@id/leftGazeText2" />

    <ImageView
        android:id="@+id/imageView11"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:layout_marginEnd="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_right_up"
        app:layout_constraintEnd_toEndOf="@id/rightUpGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightUpGazeText2" />

    <ImageView
        android:id="@+id/imageView12"
        style="@style/Vk.Badge"
        android:layout_marginTop="@dimen/vk_badge_inset"
        android:layout_marginEnd="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_right"
        app:layout_constraintEnd_toEndOf="@id/rightGazeText2"
        app:layout_constraintTop_toTopOf="@id/rightGazeText2" />

    <!-- Centre column: Switch (eyes closed) and Finish (up) -->
    <TextView
        android:id="@+id/closedGazeText2"
        style="@style/Vk.PillTile"
        android:layout_height="60dp"
        android:layout_marginEnd="@dimen/vk_half_gutter"
        android:background="@drawable/gaze_option_bg_2"
        app:layout_constraintEnd_toStartOf="@id/upGazeText2"
        app:layout_constraintStart_toStartOf="@id/centerColumn"
        app:layout_constraintTop_toTopOf="@id/centerColumn"
        tools:text="Switch" />

    <TextView
        android:id="@+id/upGazeText2"
        style="@style/Vk.PillTile"
        android:layout_height="60dp"
        android:layout_marginStart="@dimen/vk_half_gutter"
        android:background="@drawable/gaze_option_bg_2"
        app:layout_constraintEnd_toEndOf="@id/centerColumn"
        app:layout_constraintStart_toEndOf="@id/closedGazeText2"
        app:layout_constraintTop_toTopOf="@id/centerColumn"
        tools:text="Finish" />

    <ImageView
        android:id="@+id/imageView3"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_closed"
        app:layout_constraintBottom_toBottomOf="@id/closedGazeText2"
        app:layout_constraintStart_toStartOf="@id/closedGazeText2"
        app:layout_constraintTop_toTopOf="@id/closedGazeText2" />

    <ImageView
        android:id="@+id/imageView"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_up"
        app:layout_constraintBottom_toBottomOf="@id/upGazeText2"
        app:layout_constraintStart_toStartOf="@id/upGazeText2"
        app:layout_constraintTop_toTopOf="@id/upGazeText2" />

    <!-- Centre column: the sentence fills the middle; the bottom row is the mic alone, centred, until something
         is heard; then the heard text takes the row and the mic moves to its end. -->
    <TextView
        android:id="@+id/textInput2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/centerColumn"
        app:layout_constraintTop_toTopOf="@id/centerColumn" />

    <ImageButton
        android:id="@+id/recordButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/record_button_idle"
        android:contentDescription="Record what was said to you"
        android:scaleType="center"
        android:src="@drawable/baseline_mic_24"
        app:layout_constraintBottom_toBottomOf="@id/centerColumn"
        app:layout_constraintEnd_toEndOf="@id/centerColumn"
        app:layout_constraintStart_toStartOf="@id/centerColumn" />

    <TextView
        android:id="@+id/contextBox2"
        style="@style/Vk.Box"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vk_space_s"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="6"
        android:minHeight="52dp"
        android:textSize="@dimen/vk_text_caption"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/centerColumn"
        app:layout_constraintEnd_toStartOf="@id/recordButton"
        app:layout_constraintStart_toStartOf="@id/centerColumn"
        tools:text="Heard: Aapko khane me kya chahiye?"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomRowTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:constraint_referenced_ids="recordButton,contextBox2" />

    <TextView
        android:id="@+id/sentenceBox2"
        style="@style/Vk.Box"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_space_s"
        android:layout_marginBottom="@dimen/vk_space_s"
        android:background="@drawable/text_rounded_green"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:hint="@string/TextEntry_HintSentence"
        android:textSize="@dimen/vk_text_phrase"
        app:autoSizeMaxTextSize="@dimen/vk_text_phrase"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/bottomRowTop"
        app:layout_constraintEnd_toEndOf="@id/centerColumn"
        app:layout_constraintStart_toStartOf="@id/centerColumn"
        app:layout_constraintTop_toBottomOf="@id/closedGazeText2"
        tools:text="I want to drink some water." />

    <!-- Finish overlay -->
    <TextView
        android:id="@+id/darkenLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/vk_scrim"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/finishBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_space_xl"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:paddingStart="@dimen/vk_space_xl"
        android:paddingTop="@dimen/vk_space_l"
        android:paddingEnd="@dimen/vk_space_xl"
        android:paddingBottom="@dimen/vk_space_l"
        android:textAlignment="center"
        android:textColor="@color/vk_ink"
        android:textSize="30sp"
        android:translationZ="20dp"
        android:visibility="invisible"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeMinTextSize="18sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/speakButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.66"
        tools:text="I want to drink some water." />

    <TextView
        android:id="@+id/speakButton"
        style="@style/Vk.PillTile"
        android:layout_height="68dp"
        android:layout_marginTop="@dimen/vk_gutter"
        android:layout_marginEnd="@dimen/vk_half_gutter"
        android:layout_marginBottom="@dimen/vk_space_xl"
        android:text="@string/TextEntry_Speak"
        android:translationZ="22dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/backButton"
        app:layout_constraintStart_toStartOf="@id/finishBox"
        app:layout_constraintTop_toBottomOf="@id/finishBox" />

    <TextView
        android:id="@+id/backButton"
        style="@style/Vk.PillTile"
        android:layout_height="68dp"
        android:layout_marginStart="@dimen/vk_half_gutter"
        android:background="@drawable/gaze_option_bg_2"
        android:text="@string/TextEntry_Back"
        android:translationZ="22dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/speakButton"
        app:layout_constraintEnd_toEndOf="@id/finishBox"
        app:layout_constraintStart_toEndOf="@id/speakButton"
        app:layout_constraintTop_toTopOf="@id/speakButton" />

    <ImageView
        android:id="@+id/speakButtonImage"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_left"
        android:translationZ="25dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/speakButton"
        app:layout_constraintStart_toStartOf="@id/speakButton"
        app:layout_constraintTop_toTopOf="@id/speakButton" />

    <ImageView
        android:id="@+id/backButtonImage"
        style="@style/Vk.Badge"
        android:layout_marginStart="@dimen/vk_badge_inset"
        android:src="@drawable/ic_gaze_right_up"
        android:translationZ="25dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
